# Gateway Configuration
GATEWAY_PORT=4000
GATEWAY_CORS_ORIGINS=https://map.hagendigital.com,https://www.map.hagendigital.com
JWT_SECRET=CHANGE-THIS-TO-SECURE-JWT-SECRET-MIN-32-CHARS
