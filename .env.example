# ===========================================
# Hagen Logistics - Environment Configuration
# ===========================================

# Domain
DOMAIN=map.hagendigital.com

# PocketBase
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@hagendigital.com
POCKETBASE_ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# OSRM
OSRM_HOST=http://localhost:5000
OSRM_DATA_PATH=./infra/osrm/data

# VROOM
VROOM_HOST=http://localhost:3000
VROOM_ROUTER=osrm
VROOM_OSRM_URL=http://osrm:5000

# API Gateway
GATEWAY_PORT=4000
GATEWAY_CORS_ORIGINS=http://localhost:5173,https://map.hagendigital.com
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS

# Frontend
VITE_API_URL=http://localhost:4000
VITE_POCKETBASE_URL=http://localhost:8090
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_API_KEY=your-secure-api-key-here
VITE_OSRM_URL=http://localhost:5000
